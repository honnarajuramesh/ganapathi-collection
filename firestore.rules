rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - anyone can read, only authenticated server-side writes
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Collections collection - anyone can read/write (PIN auth handled in app)
    match /collections/{collectionId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
  }
}